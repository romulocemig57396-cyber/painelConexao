# Conexão com o SQL Server (DB_SGO)
DB_SERVER=host,porta
DB_NAME=DB_SGO
DB_USER=usuario
DB_PWD=senha
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_REQUEST_TIMEOUT=300000

# Porta da API
PORT=3001

# Regra de negócio (configurável sem alterar código)
# Grupo 1: medidas do filtro principal
GRUPO1_MEDIDAS=0019,0020,0021,0032,0080,0086
# Grupo 2: medidas de sinalização adicional
GRUPO2_MEDIDAS=0070,0805,0804,0700,0720
# Status considerados "pendente"
STATUS_PENDENTE=ABER,ANDM
# Tipos de nota (COD_SERVICO) incluídos no filtro — mesmos serviços disponíveis no Histórico
COD_SERVICO_FILTRO=COMT,COBT,PSAA,PSER,PSAC,PSRP,PSAG,PSAI,PSAF,PSSG,PSIP,PSST

# Inconsistências (aba "Inconsistências")
INC_COD_SERVICO_FILTRO=COMT,COBT,PSER,PSRP,PSAF
INC_DATA_CRIACAO_MINIMA=2026-01-01
INC_STATUS_NOTA_EXCLUIR=CANC,EXEC
INC_STATUS_PENDENTE=ABER,ANDM
# Tipo 1: medidas de resposta com status indevido
INC_TIPO1_MEDIDAS=0550,0501,0590,0595,0596
# Únicos status "devidos" pra essas medidas — qualquer outro status (pendente, cancelada etc.) é inconsistência
INC_TIPO1_STATUS_VALIDOS=ENCE,CONC
# Medidas de resposta das cadeias 0019->0020->0080 e 0032->0021->0086
INC_CADEIA_0019_RESPOSTA=0550,0501,0554,0590
INC_CADEIA_0032_RESPOSTA=0595,0596,0554
# Palavra que indica resposta cancelada (tipos 5/6, não conta como inconsistência)
INC_STATUS_MEDIDA_CANCELADA=CANC
# Tipo 5: resposta 0550/0501/0590 dada, mas 0020/0080 ainda pendente
INC_TIPO5_RESPOSTA=0550,0501,0590
INC_TIPO5_PENDENTE_MEDIDAS=0020,0080
# Tipo 6: espelho do tipo 5 pra cadeia 0595/0596 -> 0021/0086
INC_TIPO6_RESPOSTA=0595,0596
INC_TIPO6_PENDENTE_MEDIDAS=0021,0086

# Histórico (aba "Histórico") — 2 gráficos mensais desde HIST_DATA_MINIMA
HIST_COD_SERVICO_FILTRO=COMT
# Códigos de serviço selecionáveis no filtro (chips, multi-seleção) da aba Histórico
HIST_SERVICOS_DISPONIVEIS=COMT,COBT,PSAA,PSER,PSAC,PSRP,PSAG,PSAI,PSAF,PSSG,PSIP,PSST
HIST_DATA_MINIMA=2025-01-01
# Gráfico 1 (aprovação): medida e status (CANC > CTEC > RTEC, por prioridade)
HIST_MEDIDA_APROVACAO=0019
HIST_STATUS_CANCELADO=CANC
HIST_STATUS_APROVADO=CTEC
HIST_STATUS_REPROVADO=RTEC
# Gráfico 2 (tipo de liberação): uma medida por categoria, exclui CANC
HIST_MEDIDA_COM_OBRAS=0590
HIST_MEDIDA_SEM_OBRAS=0550
HIST_MEDIDA_SERVICOS_REDE=0501

# Link para abrir a nota no SAP (S4)
SAP_NOTA_URL_TEMPLATE=https://prd.sap.cemig.com.br/sap/bc/gui/sap/its/webgui?sap-client=100&~transaction=*IW52%20RIWO00-QMNUM={NUM_NOTA}

# Tipos de solicitação (TBL_DADOS_SOLIC.COD_FIN_ANALISE) oferecidos no filtro
# "Tipo de solicitação" dos painéis. 'SEM TIPO' = nota sem valor preenchido.
# TIPOS_SOLICITACAO_DISPONIVEIS=LN,AC,SA,OIP,LP,GD,TR,ML,RL,NT,SEM TIPO

# Classe (DES_CLASSE começando com RESID/COMERC/INDUSTR, senão OUTRAS) e faixa de
# NUM_CAIXAS (1, 2, 3, 4 OU MAIS; nulo/0 = SEM INFORMAÇÃO) — ver queries/tipoSolicitacao.js.
